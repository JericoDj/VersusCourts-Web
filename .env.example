# Public browser key. Restrict it in Google Cloud by:
# 1. HTTP referrer (production domain and localhost for development)
# 2. API access (Maps JavaScript API only)
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps cloud map ID used by Advanced Markers.
VITE_GOOGLE_MAPS_MAP_ID=

# Public API origin used by the browser. Do not place server secrets here:
# every VITE_* value is bundled into client-side JavaScript.
VITE_API_BASE_URL=https://versuscourts-backend-production.up.railway.app/api
